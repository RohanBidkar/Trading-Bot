{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "alert-bot",
	"main": "telegram_trigger_worker.js",
	"compatibility_date": "2026-09-03",
	"observability": {
		"enabled": true
	},
	// The Scanner Desk website. run_worker_first sends every request through the
	// Worker, which answers the Telegram webhook and /api itself and hands the
	// rest to ASSETS.
	"assets": {
		"directory": "./web/dist",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	// Runs and results for the website. The Worker creates its tables on first
	// use, so there is no migration step.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "alert-bot",
			"database_id": "bf21bdbc-5588-4711-af48-447bc6f75997"
		}
	]
}