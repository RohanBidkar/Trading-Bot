# Copy to .env and fill in real values. Never commit .env.

# --- Python scanner (oversold_scanner.py) ---
# From @BotFather when you create the bot
TELEGRAM_TOKEN=123456789:AAExampleBotTokenGoesHere
# Your personal chat id (message @userinfobot to get it)
TELEGRAM_CHAT_ID=987654321

# --- Cloudflare Worker (telegram_trigger_worker.js) ---
# Same bot token as above; the worker needs it to reply to you
# TELEGRAM_TOKEN=123456789:AAExampleBotTokenGoesHere
# Random string you invent; passed to setWebhook and checked on every request
TELEGRAM_SECRET_TOKEN=some-long-random-string
# GitHub fine-grained PAT with Actions: read & write on this repo
GITHUB_TOKEN=github_pat_example
GITHUB_OWNER=your-github-username
GITHUB_REPO=alert-bot
GITHUB_BRANCH=main

# --- Optional ---
# Send a "no matches" message too (default on). Set to 0 for alert-only.
NOTIFY_WHEN_EMPTY=1
